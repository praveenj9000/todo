{
  "name": "@todo/root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "sync-env": "node scripts/sync-env.mjs",
    "check-env": "node scripts/doctor.mjs",
    "new-feature": "node scripts/new-feature.mjs",
    "verify-migration": "node scripts/verify-migration.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "node scripts/check-format.mjs",
    "test": "turbo test",
    "dev": "pnpm sync-env && turbo dev",
    "build": "pnpm sync-env && turbo build",
    "typecheck": "turbo typecheck",
    "expo": "pnpm --filter @todo/app exec expo",
    "expo:check": "pnpm --filter @todo/app exec expo install --check",
    "expo:install": "pnpm --filter @todo/app exec expo install",
    "db:login": "pnpm dlx supabase login",
    "db:link": "pnpm dlx supabase link",
    "db:push": "pnpm dlx supabase db push",
    "db:pull": "pnpm dlx supabase db pull",
    "db:reset": "pnpm dlx supabase db reset",
    "db:types": "pnpm dlx supabase gen types typescript --linked > packages/types/src/database.ts",
    "db:new": "pnpm dlx supabase migration new",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "cpy-cli": "^7.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "turbo": "2.10.8",
    "typescript": "6.0.3",
    "vitest": "^3.2.4"
  }
}
