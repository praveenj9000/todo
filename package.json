{
  "name": "@todo/root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "sync-env": "node scripts/sync-env.mjs",
    "check-env": "node scripts/doctor.mjs",
    "new-feature": "node scripts/new-feature.mjs",
    "verify-migration": "node scripts/verify-migration.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "lint-staged",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "audit": "pnpm audit --audit-level=high",
    "test": "turbo test",
    "dev": "pnpm sync-env && turbo dev",
    "build": "pnpm sync-env && turbo build",
    "typecheck": "turbo typecheck",
    "expo": "pnpm --filter @todo/app exec expo",
    "expo:check": "pnpm --filter @todo/app exec expo install --check",
    "expo:install": "pnpm --filter @todo/app exec expo install",
    "db:login": "pnpm dlx supabase login",
    "db:link": "pnpm dlx supabase link",
    "db:push": "pnpm dlx supabase db push",
    "db:pull": "pnpm dlx supabase db pull",
    "db:reset": "pnpm dlx supabase db reset",
    "db:types": "pnpm dlx supabase gen types typescript --linked > packages/types/src/database.ts",
    "db:new": "pnpm dlx supabase migration new",
    "db:link:prod": "node scripts/db-link.mjs prod",
    "db:link:e2e": "node scripts/db-link.mjs e2e",
    "db:push:e2e": "node scripts/db-push-e2e.mjs",
    "dump:changes": "node scripts/dump-changed-files.mjs",
    "dump:commit": "node scripts/dump-commit-files.mjs",
    "test:e2e:local:setup": "node scripts/setup-e2e-local.mjs",
    "test:e2e:local": "pnpm --filter @todo/app test:e2e:local",
    "test:e2e": "pnpm --filter @todo/app test:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "cpy-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "2.10.8",
    "typescript": "6.0.3",
    "vitest": "^3.2.4",
    "@supabase/supabase-js": "^2.111.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": "prettier --write"
  }
}
